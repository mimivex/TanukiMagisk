<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries tools:node="removeAll" />

    <application tools:node="replace">
        <uses-library android:name="android.test.runner" />
    </application>

    <!-- Orchestrates the hide/restore flow in the test APK process,
         which survives the manager being uninstalled -->
    <instrumentation
        android:name="com.topjohnwu.magisk.test.TestRunner"
        android:targetPackage="com.topjohnwu.magisk.test" />

    <!-- Runs Environment inside the manager process -->
    <instrumentation
        android:name="com.topjohnwu.magisk.test.AppTestRunner"
        android:targetPackage="io.github.mimivex.tanuki" />

</manifest>
